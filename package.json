{
  "name": "team-agents-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "npm run test:sample-size && npm run test:checks",
    "test:sample-size": "node scripts/sample-size-check.mjs",
    "test:checks": "node scripts/checks-test.mjs",
    "test:e2e": "node scripts/run-test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply team-agents-kit --local",
    "db:migrate:remote": "wrangler d1 migrations apply team-agents-kit --remote"
  },
  "dependencies": {
    "agents": "^0.34.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
